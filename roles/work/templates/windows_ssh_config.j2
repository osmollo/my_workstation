{# Same precedence as the blockinfile per host in ssh_config.yml: the last entry with a given name wins. #}
{# Hosts with 'type' use the securitas_rsa file key, which is not exposed by the 1Password agent. #}
{% for item in ssh_config_entries | reverse | list | unique(attribute='name') | reverse | list %}
{% if item.type is not defined %}
Host {{ item.name }}
  ForwardAgent yes
{% if item.hostname is defined %}
  HostName {{ item.hostname }}
{% endif %}
{% if item.user is defined %}
  User {{ item.user }}
{% endif %}
  IdentityFile {{ win_profile_mixed.stdout }}/.ssh/securitas_ed25519.pub
  IdentitiesOnly yes

{% endif %}
{% endfor %}
